{
  "mcpServers": {
    "digigate-erp": {
      "command": "node",
      "args": [
        "/ABSOLUTE/PATH/TO/digigate-system/mcp/digigate-erp/index.mjs"
      ],
      "env": {
        "DIGIGATE_API_URL": "https://erp.digigate.id",
        "DIGIGATE_API_TOKEN": "PASTE_AGENT_API_TOKEN_HERE"
      }
    }
  }
}
